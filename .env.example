# Modelo de configuracao local do PDV Touch.
# Copie para .env e preencha com a credencial do seu ambiente.
# O .env e ignorado pelo Git e nunca deve ser versionado.

# Atencao: caracteres especiais da senha precisam ser percent-encoded na URL.
# Ex.: a senha "minh@senha" vira "minh%40senha" apenas dentro da DATABASE_URL.
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@127.0.0.1:55432/pdv_touch_dev?schema=public"

PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=pdv_touch_dev
PGUSER=postgres
PGPASSWORD=SUA_SENHA_AQUI

# Consumidos pelo docker-compose.yml via substituicao de variavel.
# Sem estes valores definidos, `npm run db:up` falha com mensagem explicita
# em vez de subir o banco com uma senha padrao conhecida.
POSTGRES_DB=pdv_touch_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUA_SENHA_AQUI
PGADMIN_DEFAULT_EMAIL=admin@pdv.com
PGADMIN_DEFAULT_PASSWORD=SUA_SENHA_AQUI

# Porta serial da balanca. Sem isso, a leitura por sensor fica desativada.
# SERIAL_PORT_PATH=COM3
